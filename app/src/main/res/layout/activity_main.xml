<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header bleu foncé -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0F3460"
                android:padding="24dp"
                android:paddingTop="50dp"
                android:paddingBottom="30dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/tvWelcome"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bonjour 👋"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                    <TextView
                        android:id="@+id/btnSettings"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="⚙️"
                        android:textSize="20sp"
                        android:gravity="center" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tableau de bord FactuPro"
                    android:textSize="13sp"
                    android:textColor="#A0C4E8" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Ligne stats 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="3dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💰 CA CE MOIS"
                                android:textSize="10sp"
                                android:textColor="#888888" />
                            <TextView
                                android:id="@+id/tvCaMois"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0,00 $"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#4CAF50"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="3dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏳ EN ATTENTE"
                                android:textSize="10sp"
                                android:textColor="#888888" />
                            <TextView
                                android:id="@+id/tvEnAttente"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0,00 $"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#FF6B35"
                                android:layout_marginTop="4dp" />
                            <TextView
                                android:id="@+id/tvEnAttenteCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 facture(s)"
                                android:textSize="10sp"
                                android:textColor="#888888" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- Ligne stats 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="3dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="👥 CLIENTS ACTIFS"
                                android:textSize="10sp"
                                android:textColor="#888888" />
                            <TextView
                                android:id="@+id/tvClientsActifs"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#2196F3"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="3dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📄 FACTURES"
                                android:textSize="10sp"
                                android:textColor="#888888" />
                            <TextView
                                android:id="@+id/tvFacturesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#9C27B0"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
                <!-- Graphique CA 6 derniers mois -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chiffre d'affaires – 6 derniers mois"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#0F3460"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:orientation="horizontal"
                            android:gravity="bottom">

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                                <View android:id="@+id/bar1" android:layout_width="28dp" android:layout_height="20dp" android:background="#D6EAF8" />
                                <TextView android:id="@+id/barLabel1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jan" android:textSize="11sp" android:textColor="#888888" android:layout_marginTop="4dp" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                                <View android:id="@+id/bar2" android:layout_width="28dp" android:layout_height="20dp" android:background="#AED6F1" />
                                <TextView android:id="@+id/barLabel2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fév" android:textSize="11sp" android:textColor="#888888" android:layout_marginTop="4dp" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                                <View android:id="@+id/bar3" android:layout_width="28dp" android:layout_height="20dp" android:background="#85C1E9" />
                                <TextView android:id="@+id/barLabel3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mar" android:textSize="11sp" android:textColor="#888888" android:layout_marginTop="4dp" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                                <View android:id="@+id/bar4" android:layout_width="28dp" android:layout_height="20dp" android:background="#5DADE2" />
                                <TextView android:id="@+id/barLabel4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Avr" android:textSize="11sp" android:textColor="#888888" android:layout_marginTop="4dp" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                                <View android:id="@+id/bar5" android:layout_width="28dp" android:layout_height="20dp" android:background="#3498DB" />
                                <TextView android:id="@+id/barLabel5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mai" android:textSize="11sp" android:textColor="#888888" android:layout_marginTop="4dp" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                                <View android:id="@+id/bar6" android:layout_width="28dp" android:layout_height="20dp" android:background="#2E86DE" />
                                <TextView android:id="@+id/barLabel6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Juin" android:textSize="11sp" android:textColor="#888888" android:layout_marginTop="4dp" />
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <!-- Actions rapides titre -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Actions rapides"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0F3460"
                    android:layout_marginBottom="12dp" />

                <!-- Card Clients -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardClients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="👥"
                            android:textSize="24sp"
                            android:gravity="center" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mes Clients"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#0F3460" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gérer vos clients"
                                android:textSize="12sp"
                                android:textColor="#888888" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="28sp"
                            android:textColor="#0F3460" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card Factures -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardFactures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="📄"
                            android:textSize="24sp"
                            android:gravity="center" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mes Factures"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#0F3460" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Créer et gérer vos factures"
                                android:textSize="12sp"
                                android:textColor="#888888" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="28sp"
                            android:textColor="#0F3460" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNewInvoice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="72dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Nouvelle facture"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#4CAF50" />
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="#0F3460"
        app:itemTextColor="#0F3460" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>