<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#0F3460"
            app:title="Mes Factures"
            app:titleTextColor="#FFFFFF" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Barre de recherche -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:startIconDrawable="@android:drawable/ic_menu_search">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Rechercher une facture..."
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Filtres -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="8dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipToutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toutes"
                    android:layout_marginEnd="8dp"
                    app:chipBackgroundColor="#0F3460"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEnAttente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="En attente"
                    android:layout_marginEnd="8dp"
                    app:chipBackgroundColor="#FFFFFF" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPayee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payées"
                    android:layout_marginEnd="8dp"
                    app:chipBackgroundColor="#FFFFFF" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEnRetard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="En retard"
                    app:chipBackgroundColor="#FFFFFF" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Liste des factures -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewInvoices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false" />

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddInvoice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="72dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Nouvelle facture"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#4CAF50" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="#0F3460"
        app:itemTextColor="#0F3460" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>